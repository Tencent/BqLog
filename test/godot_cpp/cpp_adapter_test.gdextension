[configuration]

entry_symbol = "bqlog_godot_cpp_test_init"
compatibility_minimum = "4.2"
reloadable = false

[libraries]

windows.x86_64 = "res://addons/bqlog/bin/windows/x86_64/BqLogGodotCppTest.dll"
linux.x86_64 = "res://addons/bqlog/bin/linux/x86_64/libBqLogGodotCppTest.so"
macos = "res://addons/bqlog/bin/macos/libBqLogGodotCppTest.dylib"
