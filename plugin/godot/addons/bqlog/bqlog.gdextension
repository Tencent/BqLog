[configuration]

entry_symbol = "bqlog_godot_library_init"
compatibility_minimum = "4.2"
reloadable = false

[libraries]

macos = "res://addons/bqlog/bin/macos/libBqLogGodot.dylib"
windows.x86_64 = "res://addons/bqlog/bin/windows/x86_64/BqLogGodot.dll"
windows.arm64 = "res://addons/bqlog/bin/windows/arm64/BqLogGodot.dll"
linux.x86_64 = "res://addons/bqlog/bin/linux/x86_64/libBqLogGodot.so"
linux.arm64 = "res://addons/bqlog/bin/linux/arm64/libBqLogGodot.so"
android.arm64 = "res://addons/bqlog/bin/android/arm64-v8a/libBqLogGodot.so"
android.arm32 = "res://addons/bqlog/bin/android/armeabi-v7a/libBqLogGodot.so"
android.x86_64 = "res://addons/bqlog/bin/android/x86_64/libBqLogGodot.so"
android.x86_32 = "res://addons/bqlog/bin/android/x86/libBqLogGodot.so"
ohos.arm64 = "res://addons/bqlog/bin/ohos/arm64-v8a/libBqLogGodot.so"
ohos.arm32 = "res://addons/bqlog/bin/ohos/armeabi-v7a/libBqLogGodot.so"
ohos.x86_64 = "res://addons/bqlog/bin/ohos/x86_64/libBqLogGodot.so"
ios = "res://addons/bqlog/bin/ios/BqLogGodot.xcframework"

[dependencies]

macos = { "res://addons/bqlog/bin/macos/libBqLog.dylib" : "" }
windows.x86_64 = { "res://addons/bqlog/bin/windows/x86_64/BqLog.dll" : "" }
windows.arm64 = { "res://addons/bqlog/bin/windows/arm64/BqLog.dll" : "" }
linux.x86_64 = { "res://addons/bqlog/bin/linux/x86_64/libBqLog.so" : "" }
linux.arm64 = { "res://addons/bqlog/bin/linux/arm64/libBqLog.so" : "" }
android.arm64 = { "res://addons/bqlog/bin/android/arm64-v8a/libBqLog.so" : "" }
android.arm32 = { "res://addons/bqlog/bin/android/armeabi-v7a/libBqLog.so" : "" }
android.x86_64 = { "res://addons/bqlog/bin/android/x86_64/libBqLog.so" : "" }
android.x86_32 = { "res://addons/bqlog/bin/android/x86/libBqLog.so" : "" }
ohos.arm64 = { "res://addons/bqlog/bin/ohos/arm64-v8a/libBqLog.so" : "" }
ohos.arm32 = { "res://addons/bqlog/bin/ohos/armeabi-v7a/libBqLog.so" : "" }
ohos.x86_64 = { "res://addons/bqlog/bin/ohos/x86_64/libBqLog.so" : "" }
ios = { "res://addons/bqlog/bin/ios/BqLog.xcframework" : "" }
