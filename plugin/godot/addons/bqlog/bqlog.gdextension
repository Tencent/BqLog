[configuration]

entry_symbol = "bqlog_godot_library_init"
compatibility_minimum = "4.2"
reloadable = false

[libraries]

macos.debug = "res://addons/bqlog/bin/macos/libBqLogGodot.macos.universal.dylib"
macos.release = "res://addons/bqlog/bin/macos/libBqLogGodot.macos.universal.dylib"

windows.debug.x86_64 = "res://addons/bqlog/bin/windows/x86_64/BqLogGodot.dll"
windows.release.x86_64 = "res://addons/bqlog/bin/windows/x86_64/BqLogGodot.dll"
windows.debug.arm64 = "res://addons/bqlog/bin/windows/arm64/BqLogGodot.dll"
windows.release.arm64 = "res://addons/bqlog/bin/windows/arm64/BqLogGodot.dll"

linux.debug.x86_64 = "res://addons/bqlog/bin/linux/x86_64/libBqLogGodot.so"
linux.release.x86_64 = "res://addons/bqlog/bin/linux/x86_64/libBqLogGodot.so"
linux.debug.arm64 = "res://addons/bqlog/bin/linux/arm64/libBqLogGodot.so"
linux.release.arm64 = "res://addons/bqlog/bin/linux/arm64/libBqLogGodot.so"

android.debug.arm64 = "res://addons/bqlog/bin/android/arm64-v8a/libBqLogGodot.so"
android.release.arm64 = "res://addons/bqlog/bin/android/arm64-v8a/libBqLogGodot.so"
android.debug.arm32 = "res://addons/bqlog/bin/android/armeabi-v7a/libBqLogGodot.so"
android.release.arm32 = "res://addons/bqlog/bin/android/armeabi-v7a/libBqLogGodot.so"
android.debug.x86_64 = "res://addons/bqlog/bin/android/x86_64/libBqLogGodot.so"
android.release.x86_64 = "res://addons/bqlog/bin/android/x86_64/libBqLogGodot.so"
android.debug.x86_32 = "res://addons/bqlog/bin/android/x86/libBqLogGodot.so"
android.release.x86_32 = "res://addons/bqlog/bin/android/x86/libBqLogGodot.so"

ohos.debug.arm64 = "res://addons/bqlog/bin/ohos/arm64-v8a/libBqLogGodot.so"
ohos.release.arm64 = "res://addons/bqlog/bin/ohos/arm64-v8a/libBqLogGodot.so"
ohos.debug.arm32 = "res://addons/bqlog/bin/ohos/armeabi-v7a/libBqLogGodot.so"
ohos.release.arm32 = "res://addons/bqlog/bin/ohos/armeabi-v7a/libBqLogGodot.so"
ohos.debug.x86_64 = "res://addons/bqlog/bin/ohos/x86_64/libBqLogGodot.so"
ohos.release.x86_64 = "res://addons/bqlog/bin/ohos/x86_64/libBqLogGodot.so"

ios.debug = "res://addons/bqlog/bin/ios/BqLogGodot.xcframework"
ios.release = "res://addons/bqlog/bin/ios/BqLogGodot.xcframework"

[dependencies]

macos.debug = { "res://addons/bqlog/bin/macos/libBqLog.dylib" : "" }
macos.release = { "res://addons/bqlog/bin/macos/libBqLog.dylib" : "" }

