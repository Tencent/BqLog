prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@BQ_PC_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: bqlog
Description: Lightweight, high-performance, cross-language logging library
URL: https://github.com/Tencent/BqLog
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lBqLog
Libs.private: -lpthread
Cflags: -I${includedir}
