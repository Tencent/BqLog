<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    .NET (Core) resolves runtimes/<rid>/native by itself; .NET Framework does not, so the native
    library is copied next to the assembly here.

    Every condition below is evaluated when its target runs, never while the file is evaluated: a
    package .targets file is imported before the SDK deduces TargetFrameworkIdentifier, so an
    evaluated condition would see an empty value and drop the whole thing silently.
  -->
  <Target Name="BqLogCheckPlatform"
          Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework' and '$(PlatformTarget)' == 'x86'"
          BeforeTargets="Build">
    <Error Code="BQLOG0001"
           Text="BqLog ships no 32-bit Windows native library; build the project for x64 or AnyCPU." />
  </Target>

  <Target Name="BqLogCopyNativeLibrary"
          Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'"
          AfterTargets="Build">
    <PropertyGroup>
      <BqLogNativeRid Condition="'$(BqLogNativeRid)' == '' and '$(PlatformTarget)' == 'arm64'">win-arm64</BqLogNativeRid>
      <BqLogNativeRid Condition="'$(BqLogNativeRid)' == '' and '$(PlatformTarget)' != 'x86'">win-x64</BqLogNativeRid>
      <BqLogNativeSource>$(MSBuildThisFileDirectory)..\runtimes\$(BqLogNativeRid)\native\BqLog.dll</BqLogNativeSource>
    </PropertyGroup>
    <Error Condition="!Exists('$(BqLogNativeSource)')"
           Code="BQLOG0002"
           Text="BqLog: the package carries no native library for $(BqLogNativeRid)." />
    <Copy SourceFiles="$(BqLogNativeSource)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
