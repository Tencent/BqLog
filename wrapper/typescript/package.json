{
  "name": "@pippocao/bqlog",
  "version": "1.0.0",
  "description": "High-performance cross-platform logging library for Node.js, with native C++ core. Supports sync/async modes, compressed file appenders, category logging, and more.",
  "license": "Apache-2.0",
  "author": "pippocao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tencent/BqLog.git",
    "directory": "wrapper/typescript"
  },
  "homepage": "https://github.com/Tencent/BqLog",
  "bugs": {
    "url": "https://github.com/Tencent/BqLog/issues"
  },
  "keywords": [
    "log",
    "logger",
    "logging",
    "bqlog",
    "high-performance",
    "native",
    "napi",
    "async",
    "compressed",
    "category",
    "cross-platform",
    "game-engine"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "files": [
    "dist",
    "prebuilds",
    "*.md",
    "*.MD",
    "doc",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.cjs",
    "prepublishOnly": "node -e \"require('fs').copyFileSync('README.nodejs.md','README.md')\" && npm run build",
    "postpublish": "node -e \"try{require('fs').unlinkSync('README.md')}catch(e){}\""
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=16"
  }
}
